# Copy to backend/.env for local development. REQUIRED means needed for the
# corresponding local feature; OPTIONAL variables use the documented defaults.
# Do not commit real secrets.

# Core server and database
PORT=4000                                      # OPTIONAL; default: 4000
NODE_ENV=development                           # OPTIONAL; default: development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/greenpay # REQUIRED for the database-backed API
PGCONNECT_STRING=                              # OPTIONAL legacy fallback for recurring donations only
DB_POOL_MAX=20                                 # OPTIONAL; default: 20
DB_POOL_IDLE_TIMEOUT=30000                     # OPTIONAL; default: 30000 ms
DB_POOL_CONNECT_TIMEOUT=2000                   # OPTIONAL; default: 2000 ms
MIGRATION_LOCK_TIMEOUT_SECONDS=60              # OPTIONAL; default: 60 seconds

# Authentication and browser access
JWT_SECRET=                                    # REQUIRED before enabling admin login; dev fallback is unsafe
CSRF_SECRET=                                   # OPTIONAL; defaults to JWT_SECRET for CSRF signing
UNSUBSCRIBE_SECRET=                            # OPTIONAL; falls back to JWT_SECRET; required to sign unsubscribe links
ADMIN_USERNAME=admin                           # OPTIONAL; default: admin
ADMIN_PASSWORD=                                # OPTIONAL; admin login is unavailable without a password
ADMIN_API_KEY=                                 # OPTIONAL; single admin API key
ADMIN_API_KEYS=                                # OPTIONAL; comma-separated additional/rotating admin API keys
ADMIN_SECRET=                                  # OPTIONAL; required only for the admin leaderboard endpoint
ALLOWED_ORIGINS=http://localhost:3000          # OPTIONAL; default: http://localhost:3000
APP_URL=http://localhost:3000                  # OPTIONAL; default: http://localhost:3000
API_URL=http://localhost:4000                  # OPTIONAL; default: http://localhost:<PORT>, used by digest email links

# Stellar network and contract access
STELLAR_NETWORK=testnet                        # OPTIONAL; testnet or mainnet; default: testnet
HORIZON_URL=https://horizon-testnet.stellar.org # OPTIONAL; default: testnet Horizon URL
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org # OPTIONAL recurring-donation Horizon override
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org # OPTIONAL; default: testnet Soroban RPC URL
STELLAR_TIMEOUT_MS=15000                       # OPTIONAL; default: 15000 ms
CONTRACT_ID=                                   # OPTIONAL; required for contract-backed reads and writes
USDC_ISSUER=                                   # OPTIONAL; defaults to the code's built-in USDC issuer
USDC_TO_XLM_RATE=3                             # OPTIONAL; default: 3 XLM per USDC for impact totals

# Cache and background jobs
REDIS_URL=redis://localhost:6379               # OPTIONAL; cache is bypassed when Redis is unavailable
PGBOSS_MAX_FAILED_JOBS=10                      # OPTIONAL; default: 10 failed jobs before health reports degraded
RECURRING_DONATION_CRON=                       # OPTIONAL; default: daily at 08:00 UTC; "disabled" turns it off
WEBHOOK_RETRY_CRON=                            # OPTIONAL; default schedule; "disabled" turns webhook retries off
WEEKLY_DIGEST_CRON=                            # OPTIONAL; default schedule for weekly email digests
TOKEN_CLEANUP_CRON=                            # OPTIONAL; default: daily at 03:00 UTC; "disabled" turns cleanup off
DONATIONS_RATE_LIMIT_PER_MINUTE=10              # OPTIONAL; default: 10 donations per client per minute
COMMENTS_RATE_LIMIT=5                           # OPTIONAL; default: 5 comments per client per minute
RECURRING_MAX_AMOUNT_XLM=10000                  # OPTIONAL; default: 10000 XLM maximum per recurring donation
LOG_LEVEL=info                                 # OPTIONAL; default: info

# Email and AI summaries
RESEND_API_KEY=                                # OPTIONAL; required to send email
EMAIL_FROM=GreenPay <updates@yourdomain.com>   # OPTIONAL; defaults to GreenPay <updates@greenpay.app>
ADMIN_NOTIFICATION_EMAIL=                      # OPTIONAL; defaults to EMAIL_FROM
ANTHROPIC_API_KEY=                             # OPTIONAL; required for AI summaries
CLAUDE_SUMMARY_MODEL=claude-opus-4-7            # OPTIONAL; default: claude-opus-4-7

# Upload storage: local (default), s3, or ipfs
STORAGE_BACKEND=local                          # OPTIONAL; default: local
UPLOAD_DIR=                                    # OPTIONAL; default: backend/uploads (or /tmp in Docker)
UPLOAD_MAX_BYTES=10485760                      # OPTIONAL; default: 10 MiB
PRESIGN_EXPIRY_SECONDS=300                     # OPTIONAL; default: 300 seconds
AWS_REGION=                                    # REQUIRED only for S3 storage / image moderation
AWS_ACCESS_KEY_ID=                             # REQUIRED only for S3 storage / image moderation
AWS_SECRET_ACCESS_KEY=                         # REQUIRED only for S3 storage / image moderation
S3_BUCKET=                                     # REQUIRED only for S3 storage / image moderation
S3_PUBLIC_URL=                                 # OPTIONAL public base URL for S3 objects
IPFS_API_URL=                                  # REQUIRED only for IPFS storage; HTTP API endpoint
IPFS_GATEWAY_URL=https://ipfs.io/ipfs           # OPTIONAL; default: https://ipfs.io/ipfs
PINATA_JWT=                                    # OPTIONAL; enables Pinata pinning for IPFS uploads

# Image moderation (uses the S3/AWS credentials above)
IMAGE_MODERATION_ENABLED=true                  # OPTIONAL; default: true
IMAGE_MODERATION_FAIL_MODE=closed              # OPTIONAL; default: closed; use open to allow review-flagged uploads
IMAGE_MODERATION_REJECT_CONFIDENCE=70          # OPTIONAL; default: 70
IMAGE_MODERATION_REVIEW_CONFIDENCE=50           # OPTIONAL; default: 50
IMAGE_MODERATION_REJECT_FAMILIES=Explicit Nudity,Violence # OPTIONAL; default: Explicit Nudity,Violence
IMAGE_MODERATION_TIMEOUT_MS=5000               # OPTIONAL; default: 5000 ms
COMMENT_MODERATION_ENABLED=true                # OPTIONAL; default: true
COMMENT_MODERATION_BLOCKLIST=                  # OPTIONAL; comma-separated terms to reject in comments
COMMENT_MODERATION_REVIEW_TERMS=               # OPTIONAL; comma-separated terms to flag for review
COMMENT_MODERATION_MAX_LINKS=0                 # OPTIONAL; default: 0 additional links allowed

# Optional real-time payment matching service
ENABLE_TURRETS=false                           # OPTIONAL; default: false
TURRETS_PORT=3001                               # OPTIONAL; default: 3001
MATCHER_SECRET_KEY=                            # OPTIONAL; required to submit matching payments when turrets are enabled

# Optional error reporting
SENTRY_DSN=                                    # OPTIONAL; unset disables backend error reporting

# JEST_WORKER_ID is set by Jest itself to identify test workers; do not configure it here.
