PORT=4000
NODE_ENV=development

# Sentry error tracking — https://sentry.io
# Set SENTRY_DSN to enable automatic error reporting for uncaught exceptions,
# unhandled promise rejections, and Express request errors.
# If unset, Sentry is initialized as a no-op and does not send errors.
SENTRY_DSN=
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
ALLOWED_ORIGINS=https://greenpay.app,https://www.greenpay.app,https://stellar-greenpay.app,https://www.stellar-greenpay.app,http://localhost:3000,http://127.0.0.1:3000
CONTRACT_ID=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/greenpay

# Redis — caching layer for project list and stats (60-second TTL)
# Omit or leave blank to run without Redis (cache is silently bypassed)
REDIS_URL=redis://localhost:6379

# Transactional email — get a free API key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=GreenPay <updates@yourdomain.com>
APP_URL=http://localhost:3000

# JWT secret for admin authentication (generate with: openssl rand -hex 32)
JWT_SECRET=

# Admin login credentials (used by POST /api/admin/login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Anthropic Claude API — required for AI project summaries
ANTHROPIC_API_KEY=

# PostgreSQL connection pool tuning
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECT_TIMEOUT=2000

# pg-boss health check — GET /api/health alerts (503) when failed jobs exceed this
PGBOSS_MAX_FAILED_JOBS=10

# Audit Log Retention & Cleanup
# AUDIT_LOG_RETENTION_DAYS: Number of days to retain audit logs (default: 365)
AUDIT_LOG_RETENTION_DAYS=365
# AUDIT_LOG_ARCHIVE_ENABLED: If true, archives old logs to admin_audit_log_archive table before deletion (default: false)
AUDIT_LOG_ARCHIVE_ENABLED=false
# AUDIT_LOG_CLEANUP_CRON: Cron schedule for audit log cleanup job (default: "0 2 * * *" = daily at 02:00 UTC)
# Set to "disabled" to turn off the cleanup job entirely
AUDIT_LOG_CLEANUP_CRON=0 2 * * *

# Verification Request admin notification (defaults to EMAIL_FROM)
# Used by /api/verification-requests to email admins on new submissions.
ADMIN_NOTIFICATION_EMAIL=

# Document upload backend for the /apply form.
#   local   – writes to UPLOAD_DIR and serves them at GET /api/uploads/:key.
#   s3      – requires AWS_REGION/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/S3_BUCKET.
#   ipfs    – requires IPFS_API_URL (HTTP /api/v0/add endpoint).
# Unknown/missing-credential configurations silently fall back to "local".
STORAGE_BACKEND=local

# Directory used by the "local" storage backend. Defaults to backend/uploads,
# or /tmp/greenpay-uploads when running inside Docker (detected via
# /.dockerenv), since the app directory may be read-only for a non-root user.
UPLOAD_DIR=

UPLOAD_MAX_BYTES=10485760

# S3 (only used when STORAGE_BACKEND=s3)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# Presigned URL TTL in seconds for POST /api/uploads/presign (default: 300 = 5 min).
# Clients must complete the S3 PUT within this window.
PRESIGN_EXPIRY_SECONDS=300

# IPFS (only used when STORAGE_BACKEND=ipfs)
# PINATA_JWT is required when pinning documents to IPFS via Pinata.
IPFS_API_URL=
IPFS_GATEWAY_URL=https://ipfs.io/ipfs
PINATA_JWT=
