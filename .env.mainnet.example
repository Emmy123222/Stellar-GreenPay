# Stellar GreenPay - Mainnet Configuration Example
# Copy this file to .env.mainnet and update with your production values

# ==============================================================================
# STELLAR NETWORK CONFIGURATION (REQUIRED)
# ==============================================================================
STELLAR_NETWORK=mainnet
STELLAR_RPC_URL=https://soroban-mainnet.stellar.org
CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ==============================================================================
DATABASE_URL=postgresql://username:password@production-db.example.com:5432/stellar_greenpay
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ==============================================================================
# REDIS CONFIGURATION (REQUIRED)
# ==============================================================================
REDIS_URL=redis://production-redis.example.com:6379
REDIS_PASSWORD=your_redis_password_here
REDIS_TLS=true

# ==============================================================================
# WEBHOOK CONFIGURATION (REQUIRED)
# ==============================================================================
# IMPORTANT: Must use HTTPS for mainnet deployments
WEBHOOK_URL=https://api.example.com/webhooks/stellar-greenpay
WEBHOOK_SECRET=your_webhook_signing_secret_here

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters
SESSION_SECRET=your_secure_session_secret_minimum_32_characters
CORS_ORIGINS=https://greenpay.example.com,https://app.greenpay.example.com

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# MONITORING & OBSERVABILITY
# ==============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
METRICS_ENABLED=true

# Audit Log Retention & Cleanup (Mainnet: use longer retention for compliance)
# AUDIT_LOG_RETENTION_DAYS: Number of days to retain audit logs (mainnet: 2555 = 7 years recommended)
AUDIT_LOG_RETENTION_DAYS=2555
# AUDIT_LOG_ARCHIVE_ENABLED: If true, archives old logs to admin_audit_log_archive table before deletion
AUDIT_LOG_ARCHIVE_ENABLED=true
# AUDIT_LOG_CLEANUP_CRON: Cron schedule for audit log cleanup job (mainnet: "0 3 * * 0" = weekly on Sunday at 03:00 UTC)
AUDIT_LOG_CLEANUP_CRON=0 3 * * 0

# ==============================================================================
# STELLAR SPECIFIC SETTINGS
# ==============================================================================
STELLAR_HORIZON_URL=https://horizon.stellar.org
STELLAR_PASSPHRASE=Public Global Stellar Network ; September 2015
STELLAR_TIMEOUT=30000

# ==============================================================================
# SMART CONTRACT SETTINGS
# ==============================================================================
CONTRACT_VERSION=1.0.0
CONTRACT_ADMIN_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==============================================================================
# BACKUP AND DISASTER RECOVERY
# ==============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ==============================================================================
# NOTES
# ==============================================================================
# - Run `bash scripts/mainnet-preflight.sh` before deployment
# - Ensure all secrets are rotated from testnet values
# - Use environment-specific secrets management (AWS Secrets Manager, Vault, etc.)
# - Never commit this file with real credentials to version control
