{
  "manifest_version": 3,
  "name": "GreenPay Companion",
  "version": "1.0.0",
  "description": "Support your favorite sustainable projects with a single click.",
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "GreenPay Companion"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "scripts": ["dist-firefox/background.js"]
  },
  "host_permissions": [
    "https://greenpay.app/*",
    "https://staging.greenpay.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://greenpay.app/*", "https://staging.greenpay.app/*"],
      "js": ["dist-firefox/content-script.js"],
      "run_at": "document_end"
    }
  ],
  "privacy_policy_url": "https://github.com/Emmy123222/Stellar-GreenPay/blob/main/PRIVACY.md",
  "browser_specific_settings": {
    "gecko": {
      "id": "greenpay@stellar-greenpay.com",
      "strict_min_version": "120.0"
    }
  }
}
