{
  "manifest_version": 3,
  "name": "GreenPay Companion",
  "version": "1.0.1",
  "description": "Support your favorite sustainable projects with a single click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "GreenPay Companion"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "host_permissions": [
    "https://greenpay.app/*",
    "https://staging.greenpay.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://greenpay.app/*", "https://staging.greenpay.app/*"],
      "js": ["dist/content-script.js"],
      "run_at": "document_end"
    }
  ],
  "privacy_policy_url": "https://github.com/Emmy123222/Stellar-GreenPay/blob/main/PRIVACY.md"
}