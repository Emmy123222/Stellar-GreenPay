{
  "manifest_version": 3,
  "name": "GreenPay Companion",
  "version": "1.0.1",
  "description": "Support your favorite sustainable projects with a single click.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "dark_icons": {
    "16": "icons/icon-dark-16.png",
    "32": "icons/icon-dark-32.png",
    "48": "icons/icon-dark-48.png",
    "128": "icons/icon-dark-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GreenPay Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://greenpay.app/*",
    "https://staging.greenpay.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://greenpay.app/*", "https://staging.greenpay.app/*"],
      "js": ["dist/content-script.js"],
      "run_at": "document_end"
    }
  ],
  "privacy_policy_url": "https://github.com/Emmy123222/Stellar-GreenPay/blob/main/PRIVACY.md"
}
