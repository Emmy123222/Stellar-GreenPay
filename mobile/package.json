{
  "name": "greenpay-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "EXPO_PUBLIC_USE_RN_FETCH=1 jest --passWithNoTests"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.4.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "axios": "^1.20.0",
    "expo": "~57.0.25",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "babel-plugin-jest-hoist": "^29.2.0",
    "babel-preset-expo": "~57.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "normalize-path": "^3.0.0",
    "react-test-renderer": "19.2.3",
    "to-regex-range": "^5.0.1",
    "typescript": "^7.0.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?/|@react-native/)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@stellar/.*)"
    ],
    "moduleNameMapper": {
      "^axios$": "<rootDir>/__mocks__/axios.js",
      "^@react-native-community/netinfo$": "<rootDir>/__mocks__/@react-native-community/netinfo.js",
      "^expo-local-authentication$": "<rootDir>/__mocks__/expo-local-authentication.js",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.js",
      "^expo-modules-core(.*)$": "<rootDir>/__mocks__/expo-modules-core.js",
      "^react-native-maps$": "<rootDir>/__mocks__/react-native-maps.js",
      "^react-native/Libraries/BatchedBridge/NativeModules$": "<rootDir>/__mocks__/rn-batched-bridge.js",
      "^test-renderer$": "<rootDir>/__mocks__/test-renderer.js"
    },
    "setupFiles": [
      "<rootDir>/jest.globals-polyfill.js"
    ]
  }
}
