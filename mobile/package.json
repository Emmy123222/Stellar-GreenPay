{
  "name": "greenpay-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "EXPO_PUBLIC_USE_RN_FETCH=1 jest --passWithNoTests"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/native": "^6.1.9",

    "@react-navigation/native-stack": "^7.17.6",
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@stellar/stellar-sdk": "^12.0.0",
    "axios": "^1.7.0",
    "expo-sharing": "~12.0.0",
    "react-native-view-shot": "^3.8.0",
    "expo": "~51.0.0",

    "@react-navigation/native-stack": "^6.9.17",
    "@stellar/stellar-sdk": "^16.2.0",
    "axios": "^1.19.0",
    "expo": "~51.0.0",
    "expo-barcode-scanner": "^13.0.1",

    "expo-linking": "~6.3.0",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-secure-store": "^56.0.4",
    "expo-sharing": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-view-shot": "^3.8.0"
  },
  "devDependencies": {

    "@babel/core": "^7.24.0",
    "babel-preset-expo": "~11.0.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "react-test-renderer": "18.2.0"

    "@babel/core": "^7.26.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "babel-plugin-jest-hoist": "^29.2.0",
    "babel-preset-expo": "~57.0.1",
    "jest": "^30.4.2",
    "jest-expo": "~57.0.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.9.3"

  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?/|@react-native/)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@stellar/.*)"
    ],
    "moduleNameMapper": {
      "^axios$": "<rootDir>/__mocks__/axios.js",
      "^expo-local-authentication$": "<rootDir>/__mocks__/expo-local-authentication.js",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.js",
      "^expo-modules-core(.*)$": "<rootDir>/__mocks__/expo-modules-core.js",
      "^react-native/Libraries/BatchedBridge/NativeModules$": "<rootDir>/__mocks__/rn-batched-bridge.js",
      "^test-renderer$": "<rootDir>/__mocks__/test-renderer.js"
    },
    "setupFiles": [
      "<rootDir>/jest.globals-polyfill.js"
    ]
  }
}
